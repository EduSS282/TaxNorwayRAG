# Copy to .env beside compose.demo.yaml. No source checkout is needed on the VM.
COMPOSE_FILE=compose.demo.yaml
# Docker Hub user/organization and an explicitly published release tag (never latest).
TAXGUIDE_IMAGE_NAMESPACE=
TAXGUIDE_IMAGE_TAG=
TAXGUIDE_ADMIN_TOKEN=
TAXGUIDE_UI_PORT=3000
# Set false when using Vertex for generation; embeddings still download locally.
TAXGUIDE_PULL_LOCAL_GENERATOR=true
GOOGLE_CLOUD_PROJECT=
TAXGUIDE_SERVICE_ORIGINS=https://aiplatform.googleapis.com
# On GCE use the attached VM identity. Optional external ADC file: /run/secrets/google-adc.json
GOOGLE_APPLICATION_CREDENTIALS=
