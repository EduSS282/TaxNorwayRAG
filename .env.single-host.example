# Copy this file to .env and fill the token before running docker compose up --build -d.
# .env is ignored by Git. Keep it private.
COMPOSE_FILE=compose.single-host.yaml
TAXGUIDE_ADMIN_TOKEN=
TAXGUIDE_UI_PORT=3000

# First boot downloads embeddings and the local generator. Set false for Vertex-only generation.
TAXGUIDE_PULL_LOCAL_GENERATOR=true

# Choose Vertex AI in /settings after startup. Enable Vertex AI and grant the VM identity access first.
GOOGLE_CLOUD_PROJECT=
TAXGUIDE_SERVICE_ORIGINS=https://aiplatform.googleapis.com
# Add exact regional origins to the comma-separated list when using a regional location.

# On GCE, leave empty to use the VM's attached service account through ADC.
# Outside GCE, put approved ADC credentials under secrets/ and use the CONTAINER path below.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-adc.json
GOOGLE_APPLICATION_CREDENTIALS=
